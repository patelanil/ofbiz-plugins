<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>3PL Demo Services</description>
    <vendor>Apache OFBiz</vendor>

    <service name="runFulfillment3plDemoLoop" engine="groovy" auth="true"
            location="component://3pl-demo/src/main/groovy/org/apache/ofbiz/threepldemo/ThreePlDemoServices.groovy"
            invoke="runFulfillment3plDemoLoop">
        <description>Runs the full 3PL fulfillment loop for one order in a demo store:
            receive inventory, create+approve the order, reserve, pick, pack/ship,
            stamp tracking, and read back the result. Drives stock services as system.</description>
        <attribute name="productStoreId" type="String" mode="IN" optional="false"/>
        <attribute name="externalId" type="String" mode="IN" optional="false"/>
        <attribute name="sku" type="String" mode="IN" optional="false"/>
        <attribute name="quantity" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="carrierPartyId" type="String" mode="IN" optional="true"/>
        <attribute name="shipmentMethodTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="orderId" type="String" mode="OUT" optional="false"/>
        <attribute name="orderStatusId" type="String" mode="OUT" optional="false"/>
        <attribute name="shipmentId" type="String" mode="OUT" optional="false"/>
        <attribute name="trackingIdNumber" type="String" mode="OUT" optional="false"/>
        <attribute name="receivedInventoryItemId" type="String" mode="OUT" optional="false"/>
        <attribute name="stepLog" type="List" mode="OUT" optional="false"/>
    </service>
</services>
