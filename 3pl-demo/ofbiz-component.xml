<ofbiz-component name="3pl-demo" enabled="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">
    <resource-loader name="main" type="component"/>

    <!-- Custom reader name: this demo loads ONLY when explicitly requested via
         readers=threePlDemo, so it never dirties the stock seed/demo data sets.
         Seed file FIRST (role + security), then the dataset that references them.

         Seed-ownership note: when co-loaded with a built fulfillment-api plugin
         (which owns FULFILL_API_CLIENT and the FULFILLMENT_API permission/group),
         comment out the ThreePlDemoSeed.xml line below to avoid redundant rows.
         Standalone (API not built), keep it. -->
    <entity-resource type="data" reader-name="threePlDemo" loader="main" location="data/ThreePlDemoSeed.xml"/>
    <entity-resource type="data" reader-name="threePlDemo" loader="main" location="data/ThreePlDemoData.xml"/>

    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <test-suite loader="main" location="testdef/tests.xml"/>
</ofbiz-component>
